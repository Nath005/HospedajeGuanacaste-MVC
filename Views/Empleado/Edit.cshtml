@model HospedajeGuanacaste.Models.Empleado

@{
    ViewData["Title"] = "Editar Empleado";
    
    var idOriginal = Model.Identificacion;
}

<h1>Editar Empleado</h1>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<form asp-action="Edit" asp-route-id="@idOriginal">

    <div class="form-group mt-3">
        <label>Tipo de Identificación</label>
        <select asp-for="TipoIdentificacion" class="form-control">
            <option value="Cedula">Cédula Física (Costa Rica)</option>
            <option value="DIMEX">DIMEX (Extranjeros Residentes)</option>
            <option value="Pasaporte">Pasaporte</option>
        </select>
    </div>

    <div class="form-group mt-3">
        <label>Identificación</label>
        <input asp-for="Identificacion" class="form-control" />
    </div>

    <div class="form-group mt-3">
        <label>Nombre</label>
        <input asp-for="Nombre" class="form-control" />
    </div>

    <div class="form-group mt-3">
        <label>Primer Apellido</label>
        <input asp-for="PrimerApellido" class="form-control" />
    </div>

    <div class="form-group mt-3">
        <label>Segundo Apellido</label>
        <input asp-for="SegundoApellido" class="form-control" />
    </div>

    <div class="form-group mt-3">
        <label>Fecha de Nacimiento</label>
        <input asp-for="FechaNacimiento" class="form-control" type="date" />
    </div>

    <div class="form-group mt-3">
        <label>Salario Mensual</label>
        <input asp-for="SalarioMensual" class="form-control" type="number" step="0.01" />
    </div>

    <div class="form-group mt-3">
        <label>Fecha de Ingreso</label>
        <input asp-for="FechaIngreso" class="form-control" type="date" />
    </div>

    <div class="form-group mt-3">
        <label>Categoría</label>
        <select asp-for="Categoria" class="form-control">
            <option value="">Seleccione</option>
            <option>mesero</option>
            <option>salonero</option>
            <option>lavaplatos</option>
            <option>recepcionista</option>
            <option>administrador</option>
            <option>mantenimiento</option>
            <option>cocinero</option>
            <option>chef</option>
            <option>limpieza</option>
            <option>cocina</option>
            <option>seguridad</option>
            <option>atención al cliente</option>
            <option>guía turístico</option>
            <option>encargado de reservaciones</option>
        </select>
    </div>

    <div class="form-group mt-3">
        <label>Provincia</label>
        <select asp-for="Provincia" id="comboProvincia" class="form-control" onchange="cargarCantones()">
            <option value="">Seleccione una provincia</option>
            <option value="San José">San José</option>
            <option value="Alajuela">Alajuela</option>
            <option value="Cartago">Cartago</option>
            <option value="Heredia">Heredia</option>
            <option value="Guanacaste">Guanacaste</option>
            <option value="Puntarenas">Puntarenas</option>
            <option value="Limón">Limón</option>
        </select>
    </div>

    <div class="form-group mt-3">
        <label>Cantón</label>
        <select asp-for="Canton" id="comboCanton" class="form-control" onchange="cargarDistritos()">
            <option value="">Seleccione un cantón</option>
        </select>
    </div>

    <div class="form-group mt-3">
        <label>Distrito</label>
        <select asp-for="Distrito" id="comboDistrito" class="form-control">
            <option value="">Seleccione un distrito</option>
        </select>
    </div>

    <div class="form-group mt-3">
        <label>Dirección Exacta</label>
        <textarea asp-for="DireccionExacta" class="form-control" rows="3"></textarea>
    </div>

    <br />

    <input type="submit" value="Guardar cambios" class="btn btn-primary" />
    <a asp-action="Index" class="btn btn-secondary">Volver</a>

</form>

<script>
    const datosCR = {
        "San José": {
            "San José": ["Carmen", "Merced", "Hospital", "Uruca", "Pavas"],
            "Desamparados": ["Desamparados", "San Miguel", "Damas", "San Rafael arriba", "San Rafael abajo"],
            "Pérez Zeledón": ["San Isidro de El General", "Daniel Flores", "Rivas", "San Pedro"],
            "Escazú": ["Escazú ", "San Antonio", "San Rafael"],
            "Santa Ana": ["Santa Ana ", "Salitral", "Pozos", "Piedades"]
        },
        "Alajuela": {
            "Alajuela": ["Alajuela", "San José", "Carrizal", "San Antonio", "Guácima"],
            "San Carlos": ["Quebrada Grande", "Florencia", "La Fortuna", "Ciudad Quesada", "Aguas Zarcas"],
            "San Ramón": ["San Ramón", "Santiago", "Piedades norte", "Piedades sur"],
            "Grecia": ["Grecia ", "San Roque", "Tacares", "Puente de Piedra"],
            "Atenas": ["Atenas ", "Jesús", "Mercedes"]
        },
        "Cartago": {
            "Cartago": ["Oriental", "Occidental", "San Nicolás", "Aguacaliente", "Guadalupe"],
            "Paraíso": ["Paraíso", "Santiago", "Orosi", "Cachí"],
            "La Unión": ["Tres Ríos", "San Diego", "San Juan", "Concepción"],
            "Turrialba": ["Turrialba ", "La Suiza", "Peralta", "Santa Cruz"],
            "Oreamuno": ["San Rafael", "Cot", "Potrero Cerrado"]
        },
        "Heredia": {
            "Heredia": ["Heredia", "Mercedes", "San Francisco", "Ulloa"],
            "Barva": ["Barva", "San Pedro", "San Pablo", "San Roque"],
            "Santo Domingo": ["Santo Domingo ", "San Vicente", "Santa Rosa"],
            "San Rafael": ["San Rafael ", "San Josecito", "Santiago"],
            "Belén": ["San Antonio", "La Ribera", "La Asunción"]
        },
        "Guanacaste": {
            "Liberia": ["Liberia ", "Mayorga", "Nacascolo", "Curubandé"],
            "Nicoya": ["Nicoya ", "Mansión", "Nosara", "Sámara"],
            "Santa Cruz": ["Santa Cruz ", "Bolsón", "Tamarindo", "Cabo Velas"],
            "Carrillo": ["Filadelfia", "Palmira", "Belén", "Sardinal"],
            "Cañas": ["Cañas ", "Palmira", "San Miguel"]
        },
        "Puntarenas": {
            "Puntarenas": ["Puntarenas ", "El Roble", "Chacarita", "Barranca"],
            "Esparza": ["Espíritu Santo", "San Juan Grande", "Macacona"],
            "Quepos": ["Quepos Centro", "Savegre", "Manuel Antonio"],
            "Garabito": ["Jacó", "Tárcoles"],
            "Golfito": ["Golfito ", "Puerto Jiménez", "Pavón"]
        },
        "Limón": {
            "Limón": ["Limón ", "Valle de La Estrella", "Matama"],
            "Pococí": ["Guápiles", "Jiménez", "La Roxana", "Cariari"],
            "Siquirres": ["Siquirres ", "Pacuarito", "Germania"],
            "Talamanca": ["Bribri", "Sixaola", "Cahuita"],
            "Matina": ["Matina ", "Batán", "Carrandí"]
        }
    };

    function cargarCantones() {
        const provincia = document.getElementById("comboProvincia").value;
        const comboCanton = document.getElementById("comboCanton");
        const comboDistrito = document.getElementById("comboDistrito");

        comboCanton.innerHTML = '<option value="">Seleccione un cantón</option>';
        comboDistrito.innerHTML = '<option value="">Seleccione un distrito</option>';

        if (provincia && datosCR[provincia]) {
            for (const canton in datosCR[provincia]) {
                comboCanton.innerHTML += `<option value="${canton}">${canton}</option>`;
            }
        }
    }

    function cargarDistritos() {
        const provincia = document.getElementById("comboProvincia").value;
        const canton = document.getElementById("comboCanton").value;
        const comboDistrito = document.getElementById("comboDistrito");

        comboDistrito.innerHTML = '<option value="">Seleccione un distrito</option>';

        if (provincia && canton && datosCR[provincia][canton]) {
            datosCR[provincia][canton].forEach(distrito => {
                comboDistrito.innerHTML += `<option value="${distrito}">${distrito}</option>`;
            });
        }
    }

    window.onload = function () {
        const provGuardada = "@Model.Provincia";
        const cantGuardado = "@Model.Canton";
        const distGuardado = "@Model.Distrito";

        if (provGuardada) {
            document.getElementById("comboProvincia").value = provGuardada;
            cargarCantones();

            if (cantGuardado) {
                document.getElementById("comboCanton").value = cantGuardado;
                cargarDistritos();

                if (distGuardado) {
                    document.getElementById("comboDistrito").value = distGuardado;
                }
            }
        }
    };
</script>